@page
@model McAttributes.Pages.AlertLog.IndexModel

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AlertLogEntry[0].AttrName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertLogEntry[0].Created)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertLogEntry[0].LastSeen)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertLogEntry[0].AlertHash)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertLogEntry[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertLogEntry[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlertLogEntry[0].Notes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.AlertLogEntry) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AttrName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Created)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LastSeen)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AlertHash)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Notes)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
